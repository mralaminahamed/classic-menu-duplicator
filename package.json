{
  "name": "swift-menu-duplicator",
  "version": "1.0.3",
  "description": "Duplicate WordPress navigation menus, snapshot revisions, export/import JSON, and manage every menu from one screen.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
