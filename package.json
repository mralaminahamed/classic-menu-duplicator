    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:css:fix": "stylelint \"assets/css/**/*.css\" --fix"
  },
  "devDependencies": {
    "@wordpress/eslint-plugin": "^25.8.0",
    "@wordpress/stylelint-config": "^24.1.0",
    "eslint": "^10.8.0",
    "stylelint": "^17.14.1"
  },
  "packageManager": "yarn@4.14.1"
}
