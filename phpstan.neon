# PHPStan configuration for Swift Menu Duplicator
parameters:
  level: 4
  phpVersion: 70400

  paths:
    - swift-menu-duplicator.php
    - includes/

  excludePaths:
    - vendor/
   # - node_modules/
    - tests/

  bootstrapFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

  # WP-CLI symbols come from the single self-contained aggregate stub, scanned
  # (parsed for symbols) rather than executed via bootstrapFiles — the stubs
  # reference bundled Composer classes that are not autoloaded here, which
  # crashes PHPStan on require. Scanning only the aggregate avoids the duplicate
  # declarations that the sibling *-stubs.php files would introduce.
  scanFiles:
    - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php


  # WordPress-specific configuration
  checkExplicitMixedMissingReturn: false
  checkFunctionNameCase: false
  checkInternalClassCaseSensitivity: false
  checkMissingCallableSignature: false
  checkTooWideReturnTypesInProtectedAndPublicMethods: false
  checkUninitializedProperties: false
  treatPhpDocTypesAsCertain: false

  dynamicConstantNames:
    - SWIFT_MENU_DUPLICATOR_VERSION
    - SWIFT_MENU_DUPLICATOR_FILE
    - SWIFT_MENU_DUPLICATOR_DIR
    - SWIFT_MENU_DUPLICATOR_URL

  ignoreErrors:
    # Plugin constants are define()'d at runtime in the main file, behind the
    # ABSPATH guard, so PHPStan cannot see them from the included classes.
    - identifier: constant.notFound
      message: '#Constant SWIFT_MENU_DUPLICATOR_[A-Z_]+ not found\.#'

  universalObjectCratesClasses:
    - WP_Post
    - WP_User
    - WP_Term
    - WP_Error
