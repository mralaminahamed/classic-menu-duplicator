# PHPStan configuration for Classic Menu Duplicator
parameters:
  level: 4
  phpVersion: 70400

  paths:
    - classic-menu-duplicator.php
    - includes/

  excludePaths:
    - vendor/
    - node_modules/
    - tests/

  bootstrapFiles:
    - %rootDir%/../../php-stubs/wordpress-stubs/wordpress-stubs.php
    - %rootDir%/../../php-stubs/wordpress-tests-stubs/wordpress-tests-stubs.php
    - %rootDir%/../../php-stubs/wordpress-stubs/wordpress-stubs.php
    - %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-stubs.php
    - %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
    - %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
    - %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php


  # WordPress-specific configuration
  checkExplicitMixedMissingReturn: false
  checkFunctionNameCase: false
  checkInternalClassCaseSensitivity: false
  checkMissingCallableSignature: false
  checkTooWideReturnTypesInProtectedAndPublicMethods: false
  checkUninitializedProperties: false
  treatPhpDocTypesAsCertain: false

  ignoreErrors:
    # Plugin constants (defined at runtime)
    - '#Constant CMD_[A-Z_]* not found#'

    # WordPress stub property access issues
    - '#Access to an undefined property WC_Meta_Data::\$.*#'

  dynamicConstantNames:
    - CLASSIC_MENU_DUPLICATOR_VERSION
    - CLASSIC_MENU_DUPLICATOR_FILE
    - CLASSIC_MENU_DUPLICATOR_DIR
    - CLASSIC_MENU_DUPLICATOR_URL

  universalObjectCratesClasses:
    - WP_Post
    - WP_User
    - WP_Term
    - WP_Error
