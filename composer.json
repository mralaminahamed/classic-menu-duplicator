{
	"name": "mralaminahamed/wc-gocardless-payments",
	"description": "A production-ready WooCommerce payment gateway integrating GoCardless for Direct Debit (ACH/BACS/SEPA), Instant Bank Pay, Variable Recurring Payments (VRP), and Payment Intentions.",
	"type": "wordpress-plugin",
	"version": "1.0.0",
	"license": "GPL-2.0+",
	"authors": [
		{
			"name": "Al Amin Ahamed",
			"email": "mrabir.ahamed@gmail.com"
		}
	],
	"minimum-stability": "stable",
	"require": {
		"php": ">=7.4",
      "ext-json": "*"
    },
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"phpunit/phpunit": "^9.6",
		"wp-phpunit/wp-phpunit": "^6.8.3",
		"yoast/phpunit-polyfills": "^4.0.0",
		"brain/monkey": "^2.0",
		"phpstan/phpstan": "^2.1.30",
		"phpstan/extension-installer": "^1.4",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/woocommerce-stubs": "^10.4",
		"php-stubs/woocommerce-subscriptions-stubs": "^8.1"
	},
	"autoload": {
		"classmap": [
			"includes/"
		]
	},
	"scripts": {
		"makepot": "wp i18n make-pot . languages/wc-gocardless-payments.pot --exclude=node_modules,vendor,docs,release,tests",
		"release": [
			"rm -rf release vendor build/*",
			"@makepot",
			"mkdir -p release",
			"composer install --no-dev --optimize-autoloader",
			"rsync -av --exclude-from=.distignore . release/wc-gocardless-payments/",
			"cd release && zip -r wc-gocardless-payments.zip wc-gocardless-payments/",
			"rm -rf release/wc-gocardless-payments/",
			"composer install"
		]
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
