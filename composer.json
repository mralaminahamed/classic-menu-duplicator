{
	"name": "mralaminahamed/classic-menu-duplicator",
	"description": "A simple yet powerful WordPress plugin that allows users to duplicate navigation menus with a single click.",
	"type": "wordpress-plugin",
	"version": "1.0.0",
	"license": "GPL-2.0+",
	"authors": [
		{
			"name": "Al Amin Ahamed",
			"email": "mrabir.ahamed@gmail.com"
		}
	],
	"minimum-stability": "stable",
	"require": {
		"php": ">=7.4",
		"ext-json": "*"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"phpunit/phpunit": "^9.6",
		"wp-phpunit/wp-phpunit": "^6.8.3",
		"yoast/phpunit-polyfills": "^4.0.0",
		"brain/monkey": "^2.0",
		"phpstan/phpstan": "^2.1.30",
		"phpstan/extension-installer": "^1.4",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^6.0"
	},
	"autoload": {
		"classmap": [
			"includes/"
		]
	},
	"scripts": {
		"makepot": "wp i18n make-pot . languages/classic-menu-duplicator.pot --exclude=node_modules,vendor,docs,release,tests",
		"release": [
			"rm -rf release vendor build/*",
			"@makepot",
			"mkdir -p release",
			"composer install --no-dev --optimize-autoloader",
			"rsync -av --exclude-from=.distignore . release/classic-menu-duplicator/",
			"cd release && zip -r classic-menu-duplicator.zip classic-menu-duplicator/",
			"rm -rf release/classic-menu-duplicator/",
			"composer install"
		]
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
